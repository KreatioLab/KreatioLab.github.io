a "},{"type":"strong","inlineContent":[{"text":"función","type":"text"}]},{"type":"text","text":" incorporada "},{"type":"codeVoice","code":"float"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"aside","name":"Tip","style":"tip","content":[{"type":"paragraph","inlineContent":[{"text":"Utiliza el manejo de excepciones para controlar los errores de entrada y proporcionar mensajes de error claros al usuario.","type":"text"}]}]},{"inlineContent":[{"identifier":"OIU2","type":"image"}],"type":"paragraph"},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Para convertir cadenas a números de punto flotante, usa la ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"función"}]},{"text":" incorporada ","type":"text"},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"float"}]},{"text":".","type":"text"}]}]},{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"“En la programación, como en todo arte, la simplicidad es la clave del buen diseño.”","type":"text"}]},{"type":"text","text":" - Edsger Dijkstra"}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/KreatioDocs\/documentation\/KreatioDocs\/Variables-y-Tipos-de-Datos-en-KreatioDocs","doc:\/\/KreatioDocs\/documentation\/KreatioDocs\/Calculos-Matematicos-en-KreatioDocs","doc:\/\/KreatioDocs\/documentation\/KreatioDocs\/Funcion-Print"],"generated":true}],"variants":[{"paths":["\/documentation\/kreatiodocs\/obteniendo-input-del-usuario"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/KreatioDocs\/documentation\/KreatioDocs","doc:\/\/KreatioDocs\/documentation\/KreatioDocs\/Programacion","doc:\/\/KreatioDocs\/documentation\/KreatioDocs\/Iniciando-el-Camino-en-Python-Essentials"]]},"abstract":[{"type":"text","text":"Introducción al Input del Usuario."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"modules":[{"name":"KreatioDocs"}],"images":[{"ident