:"paragraph"},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Python 3 permite el uso de caracteres Unicode para los nombres de las variables, lo que significa que puedes usar una variedad de símbolos y caracteres de otros idiomas como identificadores."}]}]},{"text":"Tipos","anchor":"Tipos","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Cada valor en Python tiene un "},{"type":"strong","inlineContent":[{"type":"text","text":"tipo"}]},{"text":" que indica el tipo de dato que representa el valor. Puedes ver el tipo de un valor, como en:","type":"text"}],"type":"paragraph"},{"syntax":"python","type":"codeListing","code":["In [7]: type(x)","Out[7]: int","","In [8]: type(10.5)","Out[8]: float"]},{"inlineContent":[{"type":"text","text":"La variable "},{"type":"codeVoice","code":"x"},{"type":"text","text":" contiene el valor entero "},{"type":"codeVoice","code":"7"},{"type":"text","text":" (del fragmento "},{"code":"[2]","type":"codeVoice"},{"text":"), por lo que Python muestra ","type":"text"},{"code":"int","type":"codeVoice"},{"text":" (abreviatura de entero). El valor ","type":"text"},{"type":"codeVoice","code":"10.5"},{"text":" es un ","type":"text"},{"inlineContent":[{"type":"text","text":"número de punto flotante"}],"type":"strong"},{"type":"text","text":" (es decir, un número con un punto decimal), por lo que Python muestra "},{"code":"float","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"La ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"función incorporada"}]},{"type":"text","text":" "},{"code":"type","type":"codeVoice"},{"type":"text","text":" de Python determina el tipo de un valor. Una "},{"type":"strong","inlineContent":[{"text":"función","type":"text"}]},{"text":" realiza una tarea cuando la ","type":"text"},{"inlineContent":[{"text":"llamas","type":"text"}],"type":"strong"},{"text":" escribiendo s